# ============================================================
# MathQuest — contoh environment variables
# Salin file ini menjadi .env.local lalu isi nilainya.
# Semua variabel bersifat OPSIONAL: tanpa variabel ini,
# MathQuest tetap berjalan penuh dalam Guest Mode.
# ============================================================

# URL proyek Supabase (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key (aman untuk browser, dibatasi oleh RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — HANYA untuk server. JANGAN pernah diberi awalan
# NEXT_PUBLIC_ dan jangan pernah di-commit ke GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# URL publik website (dipakai untuk tautan magic link). Contoh:
# http://localhost:3000 atau https://mathquest.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Daftar email administrator, dipisahkan koma (opsional).
ADMIN_EMAILS=
