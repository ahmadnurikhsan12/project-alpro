# ============================================================
# MathQuest — contoh environment variables
# Salin file ini menjadi .env.local lalu isi nilainya.
# Semua variabel bersifat OPSIONAL: tanpa variabel ini,
# MathQuest tetap berjalan penuh dalam Guest Mode.
# ============================================================

# URL proyek Supabase (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key (aman untuk browser, dibatasi oleh RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — HANYA untuk server. JANGAN pernah diberi awalan
# NEXT_PUBLIC_ dan jangan pernah di-commit ke GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# URL publik website (dipakai untuk tautan magic link). Contoh:
# http://localhost:3000 atau https://mathquest.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Daftar email administrator, dipisahkan koma (opsional).
ADMIN_EMAILS=

# ------------------------------------------------------------
# TANYA TUTOR AI (opsional). Tanpa LLM_API_KEY fitur otomatis nonaktif
# dan seluruh aplikasi tetap berjalan. HANYA di server; jangan beri
# awalan NEXT_PUBLIC_ dan jangan di-commit.
# Layanan apa pun yang kompatibel dengan API chat OpenAI dapat dipakai
# (mis. Groq, OpenRouter). Pilih paket GRATIS dan baca kebijakan datanya.
# ------------------------------------------------------------
LLM_API_KEY=
# Bawaan: https://api.groq.com/openai/v1
LLM_BASE_URL=
# Bawaan: llama-3.3-70b-versatile (periksa daftar model gratis penyedia Anda)
LLM_MODEL=
# Batas pertanyaan per hari per instance server (bawaan 800)
LLM_DAILY_CAP=
